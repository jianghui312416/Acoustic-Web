# 门户后端统一入口。生产部署时由环境注入，不要把真实环境地址写死在源码中。
VITE_PORTAL_API_URL=http://127.0.0.1:8888/

# 同步声场计算耗时较长，默认超时为 120 秒。
VITE_API_TIMEOUT_MS=120000

# 可选：拖曳线阵实时帧 WebSocket。当前后端已内置此接口；留空时使用演示数据。
# 数据格式兼容 SouthSea_SonarDetect 的 frame/t/az_true/az_peak/range_km/snr/curve 字段。
VITE_ARRAY_FUSION_WS_URL=ws://127.0.0.1:8888/ws/array-fusion

# 可选：地形预览的海底地形 WMS。默认使用 GEBCO 公共服务；内网部署时可改为本地代理。
VITE_GEBCO_WMS_URL=https://wms.gebco.net/mapserv?
VITE_GEBCO_WMS_LAYER=gebco_latest

# Optional Terrarium elevation tile base URL (z/x/y.png), including ocean bathymetry.
# Development defaults to the /bathy proxy; production defaults to the public AWS dataset.
# VITE_BATHYMETRY_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium
