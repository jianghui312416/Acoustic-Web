# 注意：认证、数据库与管理员密码属于后端，统一配置在
# D:\声场可视化软件后端\config\data_config.json 的 "AUTH" 段，不在本前端 env 中。
#
# 门户后端统一入口。生产部署时由环境注入，不要把真实环境地址写死在源码中。
VITE_PORTAL_API_URL=http://127.0.0.1:8888/

# 同步声场计算耗时较长，默认超时为 120 秒。
VITE_API_TIMEOUT_MS=120000

# 数字地球影像底图（XYZ 瓦片模板，支持 {z}/{x}/{y}）。留空时默认使用
# ArcGIS World Imagery（免 Key、支持 CORS、WGS84 对齐）。其它可选：
#   OSM：https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   高德卫星：https://webst01.is.autonavi.com/appmaptile?style=6&x={x}&y={y}&z={z}
#   本地瓦片：/tiles/img/{z}/{x}/{y}.png
# 注意：高德/腾讯为 GCJ-02 火星坐标，与声源经纬度会有偏移，精确对位请用 ArcGIS/OSM。
VITE_BASE_MAP_URL=
# 底图最大层级，留空默认 18（本地 /tiles/img 只有 0-7，请设为 7）。
VITE_BASE_MAP_MAX_LEVEL=

# 可选：拖曳线阵实时帧 WebSocket。当前后端已内置此接口；留空时使用演示数据。
# 数据格式兼容 SouthSea_SonarDetect 的 frame/t/az_true/az_peak/range_km/snr/curve 字段。
VITE_ARRAY_FUSION_WS_URL=ws://127.0.0.1:8888/ws/array-fusion

# 可选：地形预览的海底地形 WMS。默认使用 GEBCO 公共服务；内网部署时可改为本地代理。
VITE_GEBCO_WMS_URL=https://wms.gebco.net/mapserv?
VITE_GEBCO_WMS_LAYER=gebco_latest

# 本地 GEBCO 2026 sub-ice NetCDF。该路径仅由本地服务读取，不会暴露给浏览器。
GEBCO_NC_PATH=D:\JD功能开发\HYdata\GEBCO_2026_sub_ice.nc
# 可选：包含 h5py 与 numpy 的 Python 可执行文件。
GEBCO_PYTHON=python

# 海底高程默认数据源：local（本地 GEBCO NetCDF）或 online（在线 Terrarium 瓦片）。
# 界面底部可在两者之间运行时切换，选择会记住在浏览器本地。
VITE_BATHYMETRY_SOURCE=local
# 可选：在线高程瓦片地址。留空时开发环境走 /bathy 代理，生产环境直连 AWS Terrain Tiles。
VITE_BATHYMETRY_TILE_URL=
